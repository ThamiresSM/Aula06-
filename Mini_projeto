#! python3
# scraper.py - Mini projeto de Web Scraping sobre o jogo Amor Doce.
# Segue o modelo da aula: requests baixa a página, BeautifulSoup extrai
# os dados e o programa gera um site (index.html) com o resultado.
#
# Uso:
#   python scraper.py            -> tenta raspar a URL abaixo
#   python scraper.py --offline  -> usa só os dados de exemplo

import sys
import html

# ATENÇÃO: troque pela página de personagens que você escolheu raspar
# e ajuste SELETOR_NOME / SELETOR_DESC olhando o código-fonte dela.
URL = 'https://amordoce.fandom.com/pt-br/wiki/Personagens'
SELETOR_NOME = 'h3'
SELETOR_DESC = 'p'

# Dados de exemplo, usados se a raspagem falhar ou no modo --offline
EXEMPLO = [
    ('Castiel', 'O rebelde da escola, guitarrista e dono de um gênio difícil.'),
    ('Lysandre', 'Calmo e misterioso, adora música e poesia.'),
    ('Nathaniel', 'Delegado de turma, organizado e muito responsável.'),
    ('Kentin', 'Chega à escola como um novato tímido e muda com o tempo.'),
    ('Alexy', 'Divertido e animado, é um dos melhores amigos da protagonista.'),
    ('Armin', 'Fã de videogames e de piadas, sempre com um sorriso.'),
    ('Rosalya', 'Estilosa e leal, ajuda a protagonista nas horas difíceis.'),
    ('Iris', 'Gentil e sonhadora, gosta de ler e de ouvir os amigos.'),
]


def baixar_pagina(url):
    import requests
    res = requests.get(url, headers={'User-Agent': 'Mozilla/5.0 (projeto-faculdade)'}, timeout=15)
    res.raise_for_status()  # para o programa se o download deu errado
    return res.text


def extrair_personagens(texto_html):
    import bs4
    sopa = bs4.BeautifulSoup(texto_html, 'html.parser')
    personagens = []
    for titulo in sopa.select(SELETOR_NOME):
        nome = titulo.get_text(strip=True)
        paragrafo = titulo.find_next(SELETOR_DESC)
        desc = paragrafo.get_text(strip=True) if paragrafo else ''
        if nome and desc:
            personagens.append((nome, desc))
    return personagens


def gerar_site(personagens, fonte):
    cards = ''
    for nome, desc in personagens:
        cards += '<article class="card"><h3>%s</h3><p>%s</p></article>\n' % (
            html.escape(nome), html.escape(desc))
    with open('modelo.html', encoding='utf-8') as f:
        modelo = f.read()
    pagina = modelo.replace('{{CARDS}}', cards).replace('{{FONTE}}', html.escape(fonte))
    with open('index.html', 'w', encoding='utf-8') as f:
        f.write(pagina)
    print('index.html gerado com %d personagens.' % len(personagens))


if __name__ == '__main__':
    personagens, fonte = EXEMPLO, 'dados de exemplo escritos à mão'
    if '--offline' not in sys.argv:
        try:
            raspados = extrair_personagens(baixar_pagina(URL))
            if raspados:
                personagens, fonte = raspados[:12], URL
            else:
                print('Nada encontrado com os seletores. Usando dados de exemplo.')
        except Exception as exc:
            print('Houve um problema: %s' % exc)
            print('Usando dados de exemplo.')
    gerar_site(personagens, fonte)


